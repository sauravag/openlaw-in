# Local dataset roots (read-only) -- needed only by the corpus-BUILD
# scripts (build_sc_index.py, build_hc_index.py, build_graph.py,
# make_fixtures.py; see README's "Corpus build" section), NOT by the
# running API/web service itself (docker-compose.yml's `api`/`migrate`
# services set these to an unused placeholder path -- see its comments).
# `restore_acts_india.py` does not need these either -- it restores
# `acts_india` from a Qdrant snapshot mirror over HTTP, not from these
# files (Task 7 review, H2).
#
# Obtain both datasets from Hugging Face before running any build script
# that needs them:
#
#   pip install "huggingface_hub[cli]"
#   huggingface-cli download vaquill/open-india-law \
#     --repo-type dataset --local-dir /path/to/vaquill--open-india-law
#   huggingface-cli download KanoonGPT/indian-case-laws \
#     --repo-type dataset --local-dir /path/to/indian-case-laws
#
# vaquill/open-india-law is CC BY 4.0; KanoonGPT/indian-case-laws is
# Apache-2.0 (see README's "Data attribution" -- attribution is a licence
# condition for both, not a courtesy). Both are large: individual vaquill
# Parquet files reach ~4.9 GB each (openlaw.datasets.vaquill's docstring),
# and KanoonGPT's structured release is 77 files across yearly partitions
# holding 17,070,574 records (openlaw.datasets.kanoongpt's docstring) --
# budget tens of gigabytes of disk for each, on top of whatever
# docker-compose.yml's bind-mounted datastore volumes already use. Point
# these two variables at wherever you downloaded them.
OPENLAW_VAQUILL_ROOT=/path/to/vaquill--open-india-law
OPENLAW_KANOONGPT_ROOT=/path/to/indian-case-laws

# Qdrant
OPENLAW_QDRANT_URL=http://localhost:6333

# Voyage AI — required for embedding Supreme Court chunks (voyage-4, 1024-dim)
OPENLAW_VOYAGE_API_KEY=

# Corpus snapshot version
OPENLAW_CORPUS_VERSION=v2026.08

# Neo4j — local development defaults (see docker-compose.yml)
OPENLAW_NEO4J_URI=bolt://localhost:7687
OPENLAW_NEO4J_USER=neo4j
OPENLAW_NEO4J_PASSWORD=openlawdev

# Graph expansion (statute <-> case-law bridge via Neo4j). Off by default --
# see openlaw.retrieval.rerank's module docstring for the measured reason,
# and README's "Corpus build" section for the optional scripts/build_graph.py
# + scripts/run_gds.py steps this needs if you turn it on.
OPENLAW_GRAPH_EXPANSION_ENABLED=false

# Query embedding — "local_nano" (default, no API key/cost) or "voyage_api"
# (needs OPENLAW_VOYAGE_API_KEY above). See openlaw.retrieval.factory.
OPENLAW_QUERY_EMBEDDER_BACKEND=local_nano
# Optional: a pre-downloaded voyage-4-nano directory (e.g. baked into a
# container image). Leave unset to fetch from the Hugging Face Hub on first
# use — self-hosters should also set HF_HUB_DISABLE_XET=1 in that case, since
# HF's Xet download backend hangs indefinitely on a normal connection.
OPENLAW_NANO_MODEL_DIR=

# Per-role model configuration. Each role is independently overridable, and
# each value may name its PROVIDER as `<provider>:<model>`:
#
#   OPENLAW_MODEL_GENERATOR=openrouter:z-ai/glm-5.3-flash
#
# Known prefixes are `anthropic:` and `openrouter:`. A value with NO prefix
# means Anthropic, so the defaults below mean exactly what they always did.
# Only the first colon separates prefix from model, so OpenRouter ids that
# carry their own colons (`...:free`, `...:nitro`) work unchanged. An
# unrecognised prefix is refused at startup, naming this variable and the
# offending value -- never a surprise on someone's question.
#
# Provider choice is PER ROLE on purpose: running the generator on OpenRouter
# while leaving translation and crisis classification on Anthropic Haiku is a
# supported configuration, and only the providers your roles actually name
# need a key below.
OPENLAW_MODEL_GENERATOR=claude-opus-5
OPENLAW_MODEL_TRANSLATOR=claude-haiku-4-5
OPENLAW_MODEL_CLASSIFIER=claude-haiku-4-5
# Optional per-language translator overrides, as a JSON object of language
# code to model name -- Indic-specialist models often beat general models on
# Indian languages. Each value takes the same optional provider prefix, so an
# override can point one language at a different provider entirely. Empty
# means every language uses OPENLAW_MODEL_TRANSLATOR.
# OPENLAW_MODEL_TRANSLATOR_OVERRIDES={"mr": "openrouter:some-indic-model"}

# Provider API keys. Only the providers your models above actually route to
# are required: the service refuses to start when one of those is missing,
# naming it, and never asks for a key for a provider you are not using.
OPENLAW_ANTHROPIC_API_KEY=
# NOT OPENLAW_-prefixed on purpose -- this is OpenRouter's own documented
# variable name, so a key you already have works without being renamed.
OPENROUTER_API_KEY=

# Application database — local default matches docker-compose.yml's postgres
# service (bound to 127.0.0.1 only). Override in production with real
# credentials on a private network.
OPENLAW_DATABASE_URL=postgresql+psycopg://openlaw:openlaw@localhost:5432/openlaw

# Quota. `false` (unlimited use) is this file's own default -- Compose
# auto-loads `.env` for variable interpolation, so `docker-compose.yml`'s
# `${OPENLAW_QUOTA_ENABLED:-false}` fallback only applies when this is
# ABSENT, not when it disagrees (Task 7 review, C2: this shipped `true`
# here while the compose file's own default was `false`, so the documented
# `cp .env.example .env` silently turned the hosted tier's rate limit ON
# for every self-hoster, contradicting the README). Set to `true` to test
# the hosted-tier quota behaviour locally.
OPENLAW_QUOTA_ENABLED=false
OPENLAW_MONTHLY_QUOTA=30
OPENLAW_ANONYMOUS_QUOTA=3

# Supabase auth (email + Google)
OPENLAW_SUPABASE_URL=
OPENLAW_SUPABASE_JWT_SECRET=

# Where a quota/rate-limit refusal tells the caller to sign up.
OPENLAW_SIGNUP_URL=/signup

# Reverse-proxy trust for per-IP rate limiting and abuse control
# (openlaw.api.routes._client_key). Every self-hosted deployment of this
# product is expected to sit behind a reverse proxy (nginx/Caddy/Traefik) that
# terminates TLS -- see docker-compose.yml and README's self-hosting section.
# Left EMPTY, every request is trusted at face value, which is correct and
# safe ONLY when nothing sits between callers and this service (e.g. running
# `uvicorn` directly on a box with no proxy in front of it, as in local dev).
# The moment you put a reverse proxy in front of the API (required for any
# deployment reachable over the public internet), you MUST set this to that
# proxy's address as seen by the API container/process -- e.g. the reverse
# proxy's IP on the Docker Compose network (`docker network inspect
# <project>_default` after `docker compose up`), or its address on whatever
# network the API actually receives connections from. Leaving this unset
# behind a real proxy collapses per-IP rate limiting AND the anonymous quota
# into one shared bucket for the ENTIRE deployment (every request arrives
# from the proxy's one address) -- the fourth visitor of the day gets
# blocked, not the fourth from any one abuser. Setting it to an address that
# is NOT actually your proxy's, or wider than it needs to be, lets a caller
# spoof X-Forwarded-For and bypass both controls -- a real cost, since this
# service metes out paid model calls. A JSON array of IP strings (pydantic-
# settings parses this field as JSON, not a comma-separated list) --
# e.g. OPENLAW_TRUSTED_PROXY_IPS=["172.18.0.1"], or ["172.18.0.1","10.0.0.5"]
# if there is more than one trusted hop (a proxy in front of a load balancer).
# MUST be `[]`, not blank -- Settings() tolerates a genuinely blank value
# here too (see openlaw.config's field validator), but this file's own value
# is checked directly by tests/test_config.py, so it stays in the documented
# JSON-array form on purpose.
OPENLAW_TRUSTED_PROXY_IPS=[]

# Explicit acknowledgement that NO reverse proxy sits in front of this
# service. `openlaw.api.deps.production_app` refuses to start unless EITHER
# OPENLAW_TRUSTED_PROXY_IPS above is set OR this is true -- leaving both at
# their empty/false defaults is indistinguishable from "there IS a proxy and
# nobody configured it" (see the block above), so the service will not start
# silently in that state. Set this to true for a bare, no-proxy deployment
# (e.g. `uvicorn` directly on a box with nothing in front of it); set
# OPENLAW_TRUSTED_PROXY_IPS instead once you add a reverse proxy.
OPENLAW_NO_REVERSE_PROXY=false

# The anonymous-quota cookie's `Secure` flag. `true` is correct for any
# deployment reached over HTTPS, which every non-localhost deployment must
# be regardless (TLS is terminated at the reverse proxy above). This file
# ships `false` because it is also what `cp .env.example .env` hands
# `docker-compose.yml` (Task 7 review, C2 -- see OPENLAW_QUOTA_ENABLED's
# comment above for the exact failure mode this avoids), and the shipped
# self-host stack serves plain HTTP with no TLS out of the box: a `Secure`
# cookie is silently dropped by every browser on a non-HTTPS connection,
# which breaks anonymous quota tracking (every request looks like a first
# visit) rather than failing loudly. Set to `true` once you put TLS in
# front of this deployment (required for anything reachable over the
# public internet).
OPENLAW_COOKIE_SECURE=false

# Conversations and document uploads (Plan 6 T1 -- see openlaw.documents for
# the fixed content-shape and context-size limits these settings pair with).
# Kill switch: set to false to disable uploads entirely, e.g. while
# OPENLAW_DOCUMENT_ENCRYPTION_KEY below is not yet configured.
OPENLAW_UPLOADS_ENABLED=true
# Base64-encoded 32 random bytes, used to encrypt uploaded document content
# at rest. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Left blank, uploads have no key to encrypt with -- set this before turning
# OPENLAW_UPLOADS_ENABLED on in any real deployment. Every encrypted row is
# tagged with this key's fingerprint, so rotating it is now safe: new
# uploads use the new key, and old rows stay readable as long as their key
# is still available below.
OPENLAW_DOCUMENT_ENCRYPTION_KEY=
# The PREVIOUS value of OPENLAW_DOCUMENT_ENCRYPTION_KEY, kept only so
# documents encrypted under it remain readable after a rotation. Read-only:
# never used to encrypt anything new. Leave blank for a normal single-key
# deployment; set it right before rotating the key above, and remove it once
# nothing still needs it.
OPENLAW_DOCUMENT_ENCRYPTION_KEY_PREVIOUS=
# Per-upload size cap, in bytes (10 MiB).
OPENLAW_MAX_UPLOAD_BYTES=10485760
# Per-document page cap.
OPENLAW_MAX_DOCUMENT_PAGES=20
# Per-conversation document cap.
OPENLAW_MAX_DOCUMENTS_PER_CONVERSATION=3
# Hours an anonymous caller's uploaded document stays retrievable before
# it is purged.
OPENLAW_ANONYMOUS_UPLOAD_TTL_HOURS=24
# Hours an anonymous caller's conversation stays retrievable before it is
# purged.
OPENLAW_ANONYMOUS_CONVERSATION_TTL_HOURS=24
