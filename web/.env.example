# Base URL of the OpenLaw.in FastAPI backend (Task 4/5's `create_app`).
# Read only by the Next.js server (next.config.ts's `rewrites`), never sent
# to the browser -- so it is a plain env var, not NEXT_PUBLIC_*.
OPENLAW_API_URL=http://127.0.0.1:8000

# Authentication mode, read at BUILD time (Next inlines NEXT_PUBLIC_*), so
# changing it requires a rebuild. Must match the backend's
# OPENLAW_AUTH_ENABLED. `false` ships no sign-in UI at all. WARNING: false is
# not safe on a publicly reachable deployment (unlimited spend on your key).
NEXT_PUBLIC_OPENLAW_AUTH_ENABLED=false

# Mode B only. Server-side GoTrue (Supabase Auth) settings for the sign-in
# routes (app/api/auth/*). The anon key is sent as `apikey` and is never
# exposed to the browser. OPENLAW_SITE_URL is the public origin used to build
# the magic-link callback (<origin>/api/auth/callback, which must be on
# Supabase's redirect allow-list); unset, the request's own origin is used.
OPENLAW_SUPABASE_URL=
OPENLAW_SUPABASE_ANON_KEY=
OPENLAW_SITE_URL=
